<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Profitable Media 			— The Skool MRR Accelerator</title>
<link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
:root {
  --bg: #FAFAF7;
  --ink: #141311;
  --ink2: #3d3d38;
  --mute: #7a786f;
  --sand: #E8E6DF;
  --cream: #F1EFE8;
  --green: #0B5D47;
  --green-l: #D6F0E5;
  --green-d: #073D2F;
  --green-x: #05291F;
  --coral: #C4441A;
  --coral-l: #FBE9E0;
  --amber: #8B5A0B;
  --amber-l: #FDF2DC;
  --red: #922626;
  --red-l: #FCE8E8;
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{font-family:'Manrope',sans-serif;background:var(--bg);color:var(--ink);-webkit-font-smoothing:antialiased}
img{max-width:100%;display:block}
/* ── UTILITY ── */
.serif{font-family:'Instrument Serif',serif;font-weight:400}
.container{max-width:760px;margin:0 auto;padding:0 24px}
.highlight{background:linear-gradient(180deg,transparent 60%,rgba(11,93,71,0.13) 60%);display:inline;padding:0 2px}
.highlight-coral{background:linear-gradient(180deg,transparent 60%,rgba(196,68,26,0.12) 60%);display:inline;padding:0 2px}
mark{background:var(--green-l);color:var(--green);padding:2px 6px;border-radius:3px;font-weight:700}
/* ── ABOVE THE FOLD — 80% OF YOUR EFFORT ── */
.hero{
  min-height:92vh;
  display:flex;align-items:center;justify-content:center;
  text-align:center;
  padding:48px 24px 40px;
  position:relative;
  overflow:hidden;
}
.hero::before{
  content:'';position:absolute;
  top:-200px;left:50%;transform:translateX(-50%);
  width:1000px;height:1000px;
  background:radial-gradient(circle,rgba(11,93,71,0.05) 0%,transparent 65%);
  pointer-events:none;
}
.hero-inner{max-width:680px;position:relative;z-index:1}
/* Social proof ABOVE fold — Principle 1+4 */
.hero-proof-bar{
  display:inline-flex;align-items:center;gap:8px;
  background:#fff;border:1px solid var(--sand);
  border-radius:40px;padding:6px 18px 6px 8px;
  font-size:13px;color:var(--ink2);
  margin-bottom:32px;
}
.hero-proof-bar .stars{color:#E8A800;font-size:15px;letter-spacing:-1px}
.hero-proof-bar strong{color:var(--ink);font-weight:700}
.hero h1{
  font-family:'Instrument Serif',serif;
  font-size:clamp(34px,6.2vw,58px);
  line-height:1.08;font-weight:400;
  margin-bottom:24px;
}
.hero h1 em{font-style:italic;color:var(--green)}
.hero-sub{
  font-size:18px;line-height:1.65;color:var(--ink2);
  max-width:540px;margin:0 auto 32px;
}
/* CTA — Principle 1: clear single action */
.cta-btn{
  display:inline-flex;align-items:center;gap:8px;
  background:var(--green);color:#fff;
  padding:18px 36px;border-radius:10px;
  font-family:'Manrope',sans-serif;
  font-size:17px;font-weight:700;
  text-decoration:none;border:none;cursor:pointer;
  transition:background 0.2s,transform 0.1s;
}
.cta-btn:hover{background:var(--green-d)}
.cta-btn:active{transform:scale(0.98)}
.cta-btn .arrow{font-size:20px;transition:transform 0.2s}
.cta-btn:hover .arrow{transform:translateX(3px)}
.cta-note{font-size:13px;color:var(--mute);margin-top:10px}